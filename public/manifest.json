{
  "manifest_version": 3,
  "name": "Conversation Copilot",
  "version": "0.5.0",
  "description": "A live teaching assistant for online conversation tutors.",
  "minimum_chrome_version": "116",

  "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
},
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Conversation Copilot"
  }
}